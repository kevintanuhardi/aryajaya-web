---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteSettings } from '../lib/content';
import tokens from '../../../../design-system/tokens.json';
import '../styles/global.css';

const { title = 'Arjaya Langgeng Medika', description = 'Orthopedic medical device distribution', structuredData } = Astro.props as {
  title?: string;
  description?: string;
  structuredData?: Record<string, unknown>;
};
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={tokens.color.brand['500']} />
    <link rel="icon" type="image/png" href={siteSettings.logo} />
    <link rel="apple-touch-icon" href={siteSettings.logo} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={tokens.font.googleFontsHref} />
    {structuredData && (
      <script type="application/ld+json">{JSON.stringify(structuredData)}</script>
    )}
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
