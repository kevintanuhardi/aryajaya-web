---
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { siteSettings } from '../lib/content';
import tokens from '../../../../design-system/tokens.json';
import '../styles/global.css';

const {
  title = 'Arjaya Langgeng Medika',
  description = 'Orthopedic medical device distribution',
  structuredData,
  image,
  type = 'website',
  noindex = false
} = Astro.props as {
  title?: string;
  description?: string;
  structuredData?: Record<string, unknown>;
  /** Share image (absolute URL or site path). Defaults to the company logo. */
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
};

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = new URL(image || siteSettings.logo, Astro.site).href;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={siteSettings.name} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={shareImage} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={shareImage} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="theme-color" content={tokens.color.brand['500']} />
    <link rel="icon" type="image/png" href={siteSettings.logo} />
    <link rel="apple-touch-icon" href={siteSettings.logo} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={tokens.font.googleFontsHref} />
    {structuredData && (
      <script type="application/ld+json">{JSON.stringify(structuredData)}</script>
    )}
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
