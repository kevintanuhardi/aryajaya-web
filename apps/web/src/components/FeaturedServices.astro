---
import type { featuredServices } from '../data/home';
const { services } = Astro.props as { services: typeof featuredServices };
---
<section class="bg-white">
  <div class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-10 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-brand">Featured Services</p>
        <h2 class="text-3xl font-semibold text-slate-900">Arjaya's Clinical Approach</h2>
      </div>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {services.map((item) => (
        <article class="flex flex-col gap-3 rounded-2xl border border-slate-100 bg-slate-50/70 p-6 shadow-sm">
          <div class="text-3xl">{item.icon}</div>
          <h3 class="text-xl font-semibold text-slate-900">{item.title}</h3>
          <p class="text-sm text-slate-600">{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
