---
import { homeSections, type featuredServices } from '../lib/content';
const { services } = Astro.props as { services: typeof featuredServices };
---
<section class="bg-white">
  <div class="container-page section">
    <div class="mb-10 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="eyebrow">{homeSections.services.eyebrow}</p>
        <h2 class="heading-section">{homeSections.services.heading}</h2>
        {homeSections.services.description && <p class="mt-4 text-ink-600">{homeSections.services.description}</p>}
      </div>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {services.map((item) => (
        <article class="flex flex-col gap-3 card-muted">
          <div class="text-3xl">{item.icon}</div>
          <h3 class="text-xl font-semibold text-ink-900">{item.title}</h3>
          <p class="text-sm text-ink-600">{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
