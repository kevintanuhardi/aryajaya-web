---
import type { visionMission } from '../lib/content';
const { content } = Astro.props as { content: typeof visionMission };
---
<section class="bg-white">
  <div class="container-page section">
    <div class="grid gap-8 md:grid-cols-2">
      <article class="card-muted">
        <p class="eyebrow">Vision</p>
        <h3 class="mt-3 text-2xl font-semibold text-ink-900">{content.vision}</h3>
      </article>
      <article class="card">
        <p class="eyebrow">Mission</p>
        <ul class="mt-3 space-y-3 text-ink-700">
          {content.mission.map((item) => (
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 flex-shrink-0 rounded-full bg-brand"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>
