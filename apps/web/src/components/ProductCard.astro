---
import type { Product } from '../data/products';
import { getCategory } from '../data/products';
import WhatsappButton from './WhatsappButton.astro';

const { product, compact = false } = Astro.props as {
  product: Product;
  compact?: boolean;
};

const category = getCategory(product.categoryId);
---
<article class={`flex flex-col gap-4 rounded-2xl bg-white p-6 shadow-sm shadow-slate-200 ${compact ? 'md:flex-row md:items-center' : ''}`}>
  <img src={product.heroImage} alt={product.name} class={`h-40 w-full rounded-xl object-cover ${compact ? 'md:w-48' : ''}`} loading="lazy" />
  <div class="space-y-3">
    <div class="text-xs font-semibold uppercase tracking-wide text-brand">
      {category?.name}
    </div>
    <h3 class="text-xl font-semibold text-slate-900">
      <a href={`/products/${product.slug}`}>{product.name}</a>
    </h3>
    <p class="text-sm text-slate-600">{product.shortDescription}</p>
    <div class="flex flex-wrap gap-2 text-xs text-slate-500">
      {product.highlights.map((item) => (
        <span class="rounded-full bg-slate-100 px-3 py-1">{item}</span>
      ))}
    </div>
    <div class="flex items-center justify-between text-xs text-slate-400">
      <span>Sumber: {product.manufacturer}</span>
      <span class="font-semibold text-rose-500">Sample data</span>
    </div>
    <div>
      <WhatsappButton size="sm" />
    </div>
  </div>
</article>
