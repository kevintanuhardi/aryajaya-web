---
import type { Product } from '../data/products';
import { getCategory } from '../data/products';
import WhatsappButton from './WhatsappButton.astro';

const { product, compact = false } = Astro.props as {
  product: Product;
  compact?: boolean;
};

const category = getCategory(product.categoryId);
---
<article class="flex flex-col overflow-hidden rounded-xl bg-white shadow">
  <div class="space-y-2 bg-slate-900 px-4 py-4 text-white">
    <div class="text-xs font-semibold uppercase tracking-wide text-emerald-200">
      {category?.name}
    </div>
    <h3 class="text-lg font-semibold leading-tight">
      <a href={`/products/${product.slug}`} class="hover:underline">
        {product.name}
      </a>
    </h3>
    <p class="text-sm text-slate-200 line-clamp-2">{product.shortDescription}</p>
  </div>
  <img
    src={product.heroImage}
    alt={product.name}
    class="h-48 w-full object-cover"
    loading="lazy"
  />
</article>
