---
import { productCategories } from '../lib/content';
---
<section class="bg-white">
  <div class="container-page section">
    <div class="mb-10 max-w-2xl">
      <p class="eyebrow">Product Lines</p>
      <h2 class="heading-section">Arjaya Langgeng Medika clinical focus</h2>
      <p class="mt-4 text-ink-600">Priority product categories supporting orthopedic hospitals and spine surgery centers.</p>
    </div>
    <div class="grid gap-6 md:grid-cols-3">
      {productCategories.map((category) => (
        <article class="card-muted">
          <p class="text-sm font-semibold text-brand">{category.name}</p>
          <p class="mt-2 text-sm text-ink-600">{category.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
