---
import { siteSettings } from '../data/siteSettings';
import WhatsappButton from './WhatsappButton.astro';

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/products', label: 'Products' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' }
];
---
<header class="bg-white/90 backdrop-blur border-b border-slate-100 sticky top-0 z-40">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-4">
    <a class="flex items-center gap-3 text-xl font-semibold text-slate-900" href="/">
      <img src={siteSettings.logo} alt={`${siteSettings.name} logo`} class="h-11 w-11 rounded-full object-contain" />
      <span class="hidden sm:inline">{siteSettings.name}</span>
    </a>
    <nav class="hidden gap-6 text-sm font-medium text-slate-700 md:flex">
      {navLinks.map((link) => (
        <a href={link.href} class="transition hover:text-brand" aria-label={link.label}>
          {link.label}
        </a>
      ))}
    </nav>
    <div class="hidden md:block">
      <WhatsappButton size="sm" />
    </div>
    <button class="md:hidden text-slate-700" aria-label="Menu">
      ☰
    </button>
  </div>
</header>
