---
import type { heroSlides } from '../data/home';

const { slides } = Astro.props as { slides: typeof heroSlides };
const placeholderImage =
  'https://images.unsplash.com/photo-1503389152951-9f343605f61e?auto=format&fit=crop&w=1600&q=80';
---
<section class="relative isolate overflow-hidden bg-slate-900 text-white">
  <div class="relative h-[520px] w-full overflow-hidden">
    <div class="slider-track flex h-full w-full snap-x snap-mandatory overflow-x-auto scroll-smooth" aria-label="Hero slides">
      {slides.map((slide, idx) => (
        <div class="relative h-full w-full flex-shrink-0 snap-center" style="min-width: 100%" data-index={idx}>
          <img
            src={slide.image || placeholderImage}
            alt={slide.title}
            class="absolute inset-0 h-full w-full object-cover"
            loading="lazy"
            onerror={`this.onerror=null;this.src='${placeholderImage}';`}
          />
          <div class="absolute inset-0 bg-slate-900/50" />
          <div class="relative z-10 flex h-full items-center justify-center px-6 text-center">
            <div class="max-w-3xl space-y-4">
              <p class="text-sm uppercase tracking-[0.2em] text-emerald-200">Arjaya Langgeng Medika</p>
              <h1 class="text-4xl font-semibold leading-tight md:text-5xl">{slide.title}</h1>
              <p class="text-lg text-emerald-50 md:text-xl">{slide.subtitle}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
    <button class="nav-btn left-3" aria-label="Slide sebelumnya">‹</button>
    <button class="nav-btn right-3" aria-label="Slide berikutnya">›</button>
    <div class="dots absolute bottom-6 left-1/2 flex -translate-x-1/2 gap-2" aria-label="Slide indicators">
      {slides.map((_, idx) => (
        <button class="dot h-3 w-3 rounded-full bg-white/40" data-index={idx} aria-label={`Ke slide ${idx + 1}`}></button>
      ))}
    </div>
  </div>
</section>

<style>
  .slider-track::-webkit-scrollbar { display: none; }
  .nav-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.85);
    padding: 0.5rem 0.75rem;
    color: #0f172a;
    border: 1px solid rgba(226, 232, 240, 0.7);
    box-shadow: 0 10px 25px rgba(15, 23, 42, 0.18);
  }
  .nav-btn:hover { background: #fff; }
  .dot.active { background: #fff; }
</style>

<script>
  const track = document.querySelector('.slider-track');
  const slidesEls = Array.from(track?.children || []);
  const dots = Array.from(document.querySelectorAll('.dots .dot'));
  let index = 0;

  const goTo = (i) => {
    if (!track) return;
    index = (i + slidesEls.length) % slidesEls.length;
    const target = slidesEls[index];
    track.scrollTo({ left: target.offsetLeft, behavior: 'smooth' });
    dots.forEach((d, j) => d.classList.toggle('active', j === index));
  };

  document.querySelector('.nav-btn.left-3')?.addEventListener('click', () => goTo(index - 1));
  document.querySelector('.nav-btn.right-3')?.addEventListener('click', () => goTo(index + 1));
  dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));
  goTo(0);
</script>
