---
import { siteSettings } from '../lib/content';
---
<footer class="bg-ink-900 text-ink-100">
  <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 md:flex-row md:items-start md:justify-between">
    <div class="space-y-3">
      <div class="flex items-center gap-3">
        <img src={siteSettings.logo} alt={`${siteSettings.name} logo`} class="h-12 w-12 rounded-full bg-white object-contain p-1" />
        <p class="text-lg font-semibold">{siteSettings.name}</p>
      </div>
      <p class="text-sm text-ink-300">{siteSettings.tagline}</p>
      <p class="text-xs text-accent-200 max-w-xl">
        {siteSettings.disclaimer}
      </p>
    </div>
    <div class="space-y-2 text-sm">
      <p class="font-semibold text-white">{siteSettings.footerContactHeading}</p>
      <p>{siteSettings.address}</p>
      <a class="text-brand block" href={siteSettings.mapUrl} target="_blank" rel="noreferrer">
        {siteSettings.footerMapLinkLabel}
      </a>
      <p>WhatsApp: {siteSettings.whatsapp}</p>
    </div>
    {siteSettings.socials.length > 0 && (
      <div class="space-y-2 text-sm">
        <p class="font-semibold text-white">{siteSettings.footerSocialHeading}</p>
        <ul class="space-y-1">
          {siteSettings.socials.map((social) => (
            <li>
              <a href={social.url} target="_blank" rel="noreferrer" class="hover:text-brand">
                {social.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
  <div class="border-t border-ink-800 px-4 py-4 text-center text-xs text-ink-400">
    © {new Date().getFullYear()} {siteSettings.name}. All rights reserved.
  </div>
</footer>
