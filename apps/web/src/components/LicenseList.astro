---
import { homeSections, licenses } from '../lib/content';
---
<section class="bg-ink-900 text-ink-100">
  <div class="container-page section">
    <div class="mb-10 max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-wide text-accent-300">{homeSections.licenses.eyebrow}</p>
      <h2 class="text-3xl font-semibold">{homeSections.licenses.heading}</h2>
      {homeSections.licenses.description && <p class="mt-4 text-ink-300">{homeSections.licenses.description}</p>}
    </div>
    <div class="grid gap-6 md:grid-cols-2">
      {licenses.map((license) => (
        <article class="rounded-2xl border border-white/10 bg-white/5 p-6 shadow-lg shadow-black/10">
          <div class="mb-4 flex items-center gap-4">
            <div class="flex h-14 w-14 items-center justify-center rounded-2xl border border-brand-300/30 bg-brand-400/10">
              <div class="h-8 w-8 rounded-full border-2 border-brand-300/70"></div>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand-200">{license.label}</p>
              <h3 class="text-lg font-semibold">{license.title}</h3>
            </div>
          </div>
          <p class="rounded-xl border border-white/10 bg-ink-950/40 px-4 py-3 font-mono text-sm text-accent-200">
            {license.registrationNumber}
          </p>
          <p class="mt-2 text-sm text-ink-300">{license.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
