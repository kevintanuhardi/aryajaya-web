---
import WhatsappButton from './WhatsappButton.astro';
import { siteSettings } from '../data/siteSettings';
---
<section class="bg-gradient-to-br from-white via-slate-50 to-emerald-50">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-16 md:grid-cols-2 md:items-center">
    <div class="space-y-6">
      <p class="inline-flex items-center gap-2 rounded-full bg-white px-4 py-1 text-xs font-semibold uppercase tracking-wide text-brand shadow">
        Orthopedic & Spine Specialists
      </p>
      <h1 class="text-4xl font-semibold leading-tight text-slate-900 md:text-5xl">
        {siteSettings.name}
      </h1>
      <p class="text-lg text-slate-600">
        Distribution partner for orthopedic, spine, and operating room navigation medical devices for hospitals and clinics across Indonesia.
      </p>
      <div class="flex flex-wrap gap-4">
        <WhatsappButton size="lg" />
        <a href="/products" class="inline-flex items-center rounded-full border border-slate-300 px-6 py-3 text-sm font-semibold text-slate-700">
          View Products
        </a>
      </div>
    </div>
    <div class="rounded-3xl bg-white p-6 shadow-2xl shadow-brand/10">
      <dl class="grid grid-cols-2 gap-6 text-center">
        <div>
          <dt class="text-sm text-slate-500">Product Categories</dt>
          <dd class="text-3xl font-semibold text-slate-900">3</dd>
        </div>
        <div>
          <dt class="text-sm text-slate-500">Clinical Focus</dt>
          <dd class="text-3xl font-semibold text-slate-900">Orthopedics</dd>
        </div>
        <div>
          <dt class="text-sm text-slate-500">Service Area</dt>
          <dd class="text-3xl font-semibold text-slate-900">Nationwide</dd>
        </div>
        <div>
          <dt class="text-sm text-slate-500">WhatsApp Response</dt>
          <dd class="text-3xl font-semibold text-slate-900">&lt; 1 day</dd>
        </div>
      </dl>
    </div>
  </div>
</section>
