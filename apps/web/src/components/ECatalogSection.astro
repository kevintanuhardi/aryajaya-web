---
import type { Product } from '../data/products';
import { getCategory } from '../data/products';

const {
  items,
  eyebrow = 'E-Catalogue',
  heading = 'Official E-Catalogue Listings',
  description = 'Browse products with active official e-catalogue entries.',
  sectionId,
  limit,
  ctaHref,
  ctaLabel
} = Astro.props as {
  items: Product[];
  eyebrow?: string;
  heading?: string;
  description?: string;
  sectionId?: string;
  limit?: number;
  ctaHref?: string;
  ctaLabel?: string;
};

const visibleItems = typeof limit === 'number' ? items.slice(0, limit) : items;
---
{visibleItems.length > 0 && (
  <section id={sectionId} class="bg-slate-50">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div class="max-w-3xl">
          <p class="text-sm font-semibold uppercase tracking-wide text-brand">{eyebrow}</p>
          <h2 class="mt-2 text-3xl font-semibold text-slate-900">{heading}</h2>
          <p class="mt-3 text-sm leading-6 text-slate-600">{description}</p>
        </div>
        {ctaHref && ctaLabel && (
          <a
            href={ctaHref}
            class="inline-flex items-center rounded-full border border-brand/20 bg-white px-5 py-2.5 text-sm font-semibold text-brand transition hover:border-brand hover:bg-brand hover:text-white"
          >
            {ctaLabel}
          </a>
        )}
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {visibleItems.map((product) => {
          const category = getCategory(product.categoryId);
          return (
            <article class="flex h-full flex-col rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
              <div class="space-y-2">
                <p class="text-xs font-semibold uppercase tracking-wide text-brand">{category?.name}</p>
                <h3 class="text-xl font-semibold text-slate-900">{product.name}</h3>
                <p class="text-sm leading-6 text-slate-600">{product.shortDescription}</p>
              </div>
              <div class="mt-6 flex flex-wrap gap-3">
                {product.catalogUrl && (
                  <a
                    href={product.catalogUrl}
                    target="_blank"
                    rel="noreferrer"
                    class="inline-flex items-center rounded-full bg-brand px-4 py-2 text-sm font-semibold text-white transition hover:bg-brand-dark"
                  >
                    Open e-catalogue
                  </a>
                )}
                <a
                  href={`/products/${product.slug}`}
                  class="inline-flex items-center rounded-full border border-slate-200 px-4 py-2 text-sm font-semibold text-slate-700 transition hover:border-slate-300 hover:bg-slate-50"
                >
                  View product
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}
