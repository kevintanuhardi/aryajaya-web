---
import type { Product } from '../lib/content';
import { getCategory } from '../lib/content';

const {
  items,
  eyebrow = 'E-Catalogue',
  heading = 'Official E-Catalogue Listings',
  description = 'Browse products with active official e-catalogue entries.',
  sectionId,
  limit,
  ctaHref,
  ctaLabel
} = Astro.props as {
  items: Product[];
  eyebrow?: string;
  heading?: string;
  description?: string;
  sectionId?: string;
  limit?: number;
  ctaHref?: string;
  ctaLabel?: string;
};

const visibleItems = typeof limit === 'number' ? items.slice(0, limit) : items;
---
{visibleItems.length > 0 && (
  <section id={sectionId} class="bg-ink-50">
    <div class="container-page section">
      <div class="mb-8 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div class="max-w-3xl">
          <p class="eyebrow">{eyebrow}</p>
          <h2 class="mt-2 heading-section">{heading}</h2>
          <p class="mt-3 text-sm leading-6 text-ink-600">{description}</p>
        </div>
        {ctaHref && ctaLabel && (
          <a
            href={ctaHref}
            class="btn btn-outline-brand px-5"
          >
            {ctaLabel}
          </a>
        )}
      </div>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {visibleItems.map((product) => {
          const category = getCategory(product.categoryId);
          return (
            <article class="flex h-full flex-col card">
              <div class="space-y-2">
                <p class="eyebrow-sm">{category?.name}</p>
                <h3 class="text-xl font-semibold text-ink-900">{product.name}</h3>
                <p class="text-sm leading-6 text-ink-600">{product.shortDescription}</p>
              </div>
              <div class="mt-6 flex flex-wrap gap-3">
                {product.catalogUrl && (
                  <a
                    href={product.catalogUrl}
                    target="_blank"
                    rel="noreferrer"
                    class="btn btn-primary py-2"
                  >
                    Open e-catalogue
                  </a>
                )}
                <a
                  href={`/products/${product.slug}`}
                  class="btn btn-secondary py-2"
                >
                  View product
                </a>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>
)}
