---
import type { partners } from '../data/home';
const { items } = Astro.props as { items: typeof partners };
const fallbackImage = '/images/client/logos/arjaya.png';
const sliderId = `partners-slider-${Math.random().toString(36).slice(2, 8)}`;
---
<section class="bg-slate-50" data-partners-slider={sliderId}>
  <div class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-brand">Partners</p>
        <h2 class="text-3xl font-semibold text-slate-900">Technology and Manufacturing Partners</h2>
      </div>
    </div>
    <div class="relative">
      <div class="overflow-hidden">
        <div class="partner-track flex transition-transform duration-500 ease-out" aria-label="Partner carousel">
          {items.map((partner) => (
            <div class="w-full flex-none px-2 md:w-1/2 lg:w-1/3">
              <article class="h-full rounded-2xl border border-slate-100 bg-white p-4 shadow-sm">
                <div class="h-32 w-full overflow-hidden rounded-xl bg-slate-100">
                  <img
                    src={partner.image || fallbackImage}
                    alt={partner.name}
                    class="h-full w-full object-contain p-4"
                    loading="lazy"
                  />
                </div>
                <div class="mt-4 space-y-1">
                  <p class="text-sm font-semibold text-slate-900">{partner.name}</p>
                  <p class="text-xs text-slate-500">{partner.subtitle}</p>
                </div>
              </article>
            </div>
          ))}
        </div>
      </div>
      <button class="p-nav left-0" type="button" data-prev aria-label="Previous partners">‹</button>
      <button class="p-nav right-0" type="button" data-next aria-label="Next partners">›</button>
      <div class="p-dots mt-4 flex justify-center gap-2" data-dots></div>
    </div>
  </div>
</section>

<style>
  .p-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    border-radius: 9999px;
    background: #fff;
    padding: 0.5rem 0.75rem;
    color: #0f172a;
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: 0 10px 20px rgba(15, 23, 42, 0.12);
  }
  .p-nav:hover { background: #f8fafc; }
  .p-dot.active { background: #0D7C66; }
</style>

<script define:vars={{ sliderId }}>
  const root = document.querySelector(`[data-partners-slider="${sliderId}"]`);
  if (root) {
    const track = root.querySelector('.partner-track');
    const cards = Array.from(track?.children || []);
    const dotsContainer = root.querySelector('[data-dots]');
    const prevButton = root.querySelector('[data-prev]');
    const nextButton = root.querySelector('[data-next]');
    let pageIndex = 0;
    let itemsPerPage = 1;
    let pageCount = 1;

    const getItemsPerPage = () => {
      const width = window.innerWidth;
      if (width >= 1024) return 3;
      if (width >= 768) return 2;
      return 1;
    };

    const renderDots = () => {
      if (!dotsContainer) return;
      dotsContainer.innerHTML = '';
      for (let index = 0; index < pageCount; index += 1) {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'p-dot h-2.5 w-2.5 rounded-full bg-slate-300';
        button.setAttribute('aria-label', `Partner page ${index + 1}`);
        button.addEventListener('click', () => {
          pageIndex = index;
          render();
        });
        dotsContainer.appendChild(button);
      }
    };

    const render = () => {
      if (!track) return;
      track.style.transform = `translateX(-${pageIndex * 100}%)`;
      const dots = Array.from(root.querySelectorAll('.p-dot'));
      dots.forEach((dot, index) => {
        dot.classList.toggle('active', index === pageIndex);
      });
      prevButton?.toggleAttribute('disabled', pageIndex === 0);
      nextButton?.toggleAttribute('disabled', pageIndex >= pageCount - 1);
      prevButton?.classList.toggle('opacity-40', pageIndex === 0);
      nextButton?.classList.toggle('opacity-40', pageIndex >= pageCount - 1);
    };

    const recalc = () => {
      itemsPerPage = getItemsPerPage();
      pageCount = Math.max(1, Math.ceil(cards.length / itemsPerPage));
      pageIndex = Math.min(pageIndex, pageCount - 1);
      renderDots();
      render();
    };

    prevButton?.addEventListener('click', () => {
      if (pageIndex > 0) {
        pageIndex -= 1;
        render();
      }
    });

    nextButton?.addEventListener('click', () => {
      if (pageIndex < pageCount - 1) {
        pageIndex += 1;
        render();
      }
    });

    window.addEventListener('resize', recalc);
    recalc();
  }
</script>
