---
import type { partners } from '../data/home';
const { items } = Astro.props as { items: typeof partners };
const placeholderImage =
  'https://images.unsplash.com/photo-1498050108023-c5249f4df085?auto=format&fit=crop&w=800&q=80';
---
<section class="bg-slate-50">
  <div class="mx-auto max-w-6xl px-4 py-16">
    <div class="mb-8 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wide text-brand">Mitra</p>
        <h2 class="text-3xl font-semibold text-slate-900">Partner teknologi dan manufaktur</h2>
      </div>
    </div>
    <div class="relative">
      <div class="partner-track flex gap-4 overflow-x-auto scroll-smooth pb-4" aria-label="Partner carousel">
        {items.map((partner, idx) => (
          <article class="min-w-[240px] flex-1 rounded-2xl border border-slate-100 bg-white p-4 shadow-sm snap-center" data-index={idx}>
            <div class="h-32 w-full overflow-hidden rounded-xl bg-slate-100">
              <img
                src={partner.image || placeholderImage}
                alt={partner.name}
                class="h-full w-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="mt-4 space-y-1">
              <p class="text-sm font-semibold text-slate-900">{partner.name}</p>
              <p class="text-xs text-slate-500">{partner.subtitle}</p>
            </div>
          </article>
        ))}
      </div>
      <button class="p-nav left-0" aria-label="Partner sebelumnya">‹</button>
      <button class="p-nav right-0" aria-label="Partner berikutnya">›</button>
      <div class="p-dots mt-4 flex justify-center gap-2">
        {items.map((_, idx) => (
          <button class="dot h-2.5 w-2.5 rounded-full bg-slate-300" data-index={idx} aria-label={`Partner ${idx + 1}`}></button>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .partner-track { scroll-snap-type: x mandatory; }
  .partner-track::-webkit-scrollbar { display: none; }
  .p-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    border-radius: 9999px;
    background: #fff;
    padding: 0.5rem 0.75rem;
    color: #0f172a;
    border: 1px solid rgba(226, 232, 240, 0.9);
    box-shadow: 0 10px 20px rgba(15, 23, 42, 0.12);
    display: none;
  }
  @media (min-width: 768px) { .p-nav { display: block; } }
  .p-nav:hover { background: #f8fafc; }
  .dot.active { background: #0D7C66; }
</style>

<script>
  const track = document.querySelector('.partner-track');
  const cards = Array.from(track?.children || []);
  const dots = Array.from(document.querySelectorAll('.p-dots .dot'));
  let index = 0;
  const go = (i) => {
    if (!track) return;
    index = (i + cards.length) % cards.length;
    track.scrollTo({ left: cards[index].offsetLeft - 16, behavior: 'smooth' });
    dots.forEach((d, j) => d.classList.toggle('active', j === index));
  };
  document.querySelector('.p-nav.left-0')?.addEventListener('click', () => go(index - 1));
  document.querySelector('.p-nav.right-0')?.addEventListener('click', () => go(index + 1));
  dots.forEach((dot, i) => dot.addEventListener('click', () => go(i)));
  go(0);
</script>
