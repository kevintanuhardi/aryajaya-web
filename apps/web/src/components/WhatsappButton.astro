---
import { siteSettings } from '../lib/content';

const { label = 'Consult via WhatsApp', size = 'md' } = Astro.props as {
  label?: string;
  size?: 'sm' | 'md' | 'lg';
};

const sizeClass = { sm: 'btn-sm', md: '', lg: 'btn-lg' }[size];
---
<a href={siteSettings.whatsappLink} target="_blank" rel="noreferrer" class:list={['btn btn-primary', sizeClass]}>
  <span>{label}</span>
</a>
