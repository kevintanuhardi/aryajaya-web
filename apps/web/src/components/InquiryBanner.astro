---
import WhatsappButton from './WhatsappButton.astro';
import { homeSections } from '../lib/content';

const banner = homeSections.inquiryBanner;
---
<section class="bg-brand text-white">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-4 py-10 text-center md:flex-row md:gap-10 md:text-left">
    <div>
      <p class="eyebrow-200">{banner.eyebrow}</p>
      <h2 class="text-2xl font-semibold">{banner.heading}</h2>
      <p class="text-sm text-brand-100">{banner.text}</p>
    </div>
    <WhatsappButton size="lg" label={banner.buttonLabel} />
  </div>
</section>
