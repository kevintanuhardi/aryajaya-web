---
import WhatsappButton from './WhatsappButton.astro';
---
<section class="bg-brand text-white">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-4 py-10 text-center md:flex-row md:gap-10 md:text-left">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-emerald-200">Butuh rekomendasi alat?</p>
      <h2 class="text-2xl font-semibold">Diskusikan kebutuhan ortopedi Anda</h2>
      <p class="text-sm text-emerald-100">Tim klinis kami siap membantu memilih portofolio produk yang paling relevan.</p>
    </div>
    <WhatsappButton size="lg" label="Chat WhatsApp" />
  </div>
</section>
