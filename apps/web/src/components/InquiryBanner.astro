---
import WhatsappButton from './WhatsappButton.astro';
---
<section class="bg-brand text-white">
  <div class="mx-auto flex max-w-5xl flex-col items-center gap-4 px-4 py-10 text-center md:flex-row md:gap-10 md:text-left">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-emerald-200">Need product recommendations?</p>
      <h2 class="text-2xl font-semibold">Discuss your orthopedic needs</h2>
      <p class="text-sm text-emerald-100">Our clinical team is ready to help select the most relevant product portfolio.</p>
    </div>
    <WhatsappButton size="lg" label="Contact us on WhatsApp" />
  </div>
</section>
