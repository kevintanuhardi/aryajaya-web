---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { events, postKindLabels } from '../../lib/content';
import type { EventItem } from '../../lib/content';
import WhatsappButton from '../../components/WhatsappButton.astro';

export async function getStaticPaths() {
  return events.map((event) => ({
    params: { slug: event.slug },
    props: { event }
  }));
}

const { event } = Astro.props as { event: EventItem };

const createdAtLabel = new Date(event.createdAt).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
});

const isEvent = event.kind === 'event';
const kindLabel = postKindLabels[event.kind];
const structuredData = isEvent
  ? { '@type': 'Event', name: event.title, startDate: event.eventDateStart }
  : { '@type': event.kind === 'news' ? 'NewsArticle' : 'Article', headline: event.title, datePublished: event.createdAt };
---
<BaseLayout
  title={`${event.title} | Arjaya News & Events`}
  description={event.excerpt}
  image={event.image || undefined}
  type="article"
  structuredData={{
    '@context': 'https://schema.org',
    ...structuredData,
    description: event.excerpt,
    image: [event.image]
  }}
>
  <article class="bg-white">
    <div class="mx-auto max-w-5xl px-4 py-16">
      <nav class="text-sm text-ink-500">
        <a href="/events" class="hover:text-brand">← Back to events</a>
      </nav>
      <div class="mt-6 grid gap-10 md:grid-cols-[1.2fr_0.8fr]">
        <div class="space-y-6">
          <p class="eyebrow-sm">{kindLabel} · {event.eventDate}</p>
          <h1 class="text-4xl font-semibold text-ink-900">{event.title}</h1>
          <p class="text-sm leading-7 text-ink-600">{event.excerpt}</p>
          <img src={event.image} alt={event.title} class="w-full rounded-3xl object-cover shadow-lg" />
          <div class="space-y-5 text-sm leading-7 text-ink-700">
            {event.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
        <aside class="space-y-5">
          <div class="rounded-3xl border border-ink-100 bg-ink-50 p-6">
            <p class="text-sm font-semibold text-ink-500">{kindLabel} information</p>
            <dl class="mt-4 space-y-4">
              {isEvent && (
                <div>
                  <dt class="text-xs font-semibold uppercase tracking-wide text-ink-500">Event date</dt>
                  <dd class="mt-1 text-sm text-ink-700">{event.eventDate}</dd>
                </div>
              )}
              <div>
                <dt class="text-xs font-semibold uppercase tracking-wide text-ink-500">Created at</dt>
                <dd class="mt-1 text-sm text-ink-700">{createdAtLabel}</dd>
              </div>
            </dl>
          </div>
          <WhatsappButton size="md" />
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>
