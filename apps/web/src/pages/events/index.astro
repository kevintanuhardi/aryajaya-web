---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EventCard from '../../components/EventCard.astro';
import { events, listingPages } from '../../lib/content';

const { seo, intro } = listingPages.events;
---
<BaseLayout title={seo.title} description={seo.description}>
  <section class="bg-white">
    <div class="container-page section">
      <div class="max-w-3xl">
        <p class="eyebrow">{intro.eyebrow}</p>
        <h1 class="mt-2 text-4xl font-semibold text-ink-900">{intro.heading}</h1>
        {intro.description && <p class="mt-4 text-sm leading-6 text-ink-600">{intro.description}</p>}
      </div>
      {events.length > 0 ? (
        <div class="mt-10 grid gap-6 lg:grid-cols-2">
          {events.map((event) => (
            <EventCard event={event} />
          ))}
        </div>
      ) : (
        <p class="mt-10 rounded-card border border-dashed border-ink-200 p-6 text-sm text-ink-500">
          No events have been published yet.
        </p>
      )}
    </div>
  </section>
</BaseLayout>
