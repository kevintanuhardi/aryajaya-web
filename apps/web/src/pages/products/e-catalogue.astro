---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ECatalogSection from '../../components/ECatalogSection.astro';
import { getEcatalogProducts, listingPages } from '../../lib/content';

const items = getEcatalogProducts();
const { seo, intro } = listingPages.ecatalogue;
---
<BaseLayout title={seo.title} description={seo.description}>
  <section class="bg-white">
    <div class="container-page section">
      <nav class="text-sm text-ink-500">
        <a href="/products" class="hover:text-brand">← Back to products</a>
      </nav>
    </div>
  </section>
  <ECatalogSection
    items={items}
    eyebrow={intro.eyebrow}
    heading={intro.heading}
    description={intro.description}
  />
</BaseLayout>
