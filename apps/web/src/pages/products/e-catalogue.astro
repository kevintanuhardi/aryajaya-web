---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ECatalogSection from '../../components/ECatalogSection.astro';
import { getEcatalogProducts } from '../../lib/content';

const items = getEcatalogProducts();
---
<BaseLayout title="Arjaya E-Catalogue" description="Official e-catalogue product listings from Arjaya Langgeng Medika">
  <section class="bg-white">
    <div class="container-page section">
      <nav class="text-sm text-ink-500">
        <a href="/products" class="hover:text-brand">← Back to products</a>
      </nav>
    </div>
  </section>
  <ECatalogSection
    items={items}
    heading="Official E-Catalogue Listings"
    description="Browse products with active official INAPROC e-catalogue entries. Each card links directly to the listing and to the corresponding product detail page."
  />
</BaseLayout>
