---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { products, getCategory } from '../../lib/content';
import type { Product } from '../../lib/content';
import WhatsappButton from '../../components/WhatsappButton.astro';

export async function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product }
  }));
}

const { product } = Astro.props as { product: Product };
const category = getCategory(product.categoryId);
---
<BaseLayout
  title={`${product.name} | Arjaya Langgeng Medika`}
  description={product.shortDescription}
  structuredData={{
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: product.name,
    category: category?.name,
    description: product.shortDescription,
    brand: product.manufacturer
  }}
>
  <article class="bg-white">
    <div class="mx-auto max-w-5xl px-4 py-16">
      <nav class="text-sm text-ink-500">
        <a href="/products" class="hover:text-brand">← Back to products</a>
      </nav>
      <div class="mt-6 grid gap-10 md:grid-cols-2">
        {product.heroImage ? (
          <div class="flex min-h-[360px] items-center justify-center rounded-3xl bg-ink-50 p-6 shadow-lg">
            <img src={product.heroImage} alt={product.name} class="max-h-[420px] w-full object-contain" loading="lazy" />
          </div>
        ) : (
          <div class="flex min-h-[360px] flex-col justify-between rounded-3xl bg-gradient-to-br from-white via-ink-50 to-brand-50 p-8 shadow-lg">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-brand">{category?.name}</p>
            <div class="space-y-4">
              <div class="h-16 w-16 rounded-[1.5rem] border border-brand/20 bg-brand/10"></div>
              <h2 class="max-w-md text-3xl font-semibold leading-tight text-ink-900">{product.name}</h2>
              <p class="max-w-lg text-sm leading-6 text-ink-600">The product visual will be updated once the final image asset is available.</p>
            </div>
          </div>
        )}
        <div class="space-y-4">
          <p class="eyebrow-sm">{category?.name}</p>
          <h1 class="text-4xl font-semibold text-ink-900">{product.name}</h1>
          <p class="text-ink-600">{product.shortDescription}</p>
          <p class="text-sm leading-6 text-ink-600">{product.body}</p>
          <div class="space-y-2">
            <p class="text-sm font-semibold text-ink-500">Highlights</p>
            <ul class="list-disc space-y-1 pl-5 text-sm text-ink-600">
              {product.highlights.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </div>
          <div class="rounded-2xl bg-ink-50 p-4 text-xs">
            <p class="font-semibold text-ink-500">Product information</p>
            <p class="text-ink-600">{product.manufacturer}</p>
            {product.source && (
              <a href={product.source} class="mt-2 inline-flex text-brand" target="_blank" rel="noreferrer">
                {product.sourceLabel ?? 'Open product document'}
              </a>
            )}
          </div>
          <div class="flex flex-wrap gap-3">
            <WhatsappButton size="md" />
            {product.catalogUrl && (
              <a
                href={product.catalogUrl}
                target="_blank"
                rel="noreferrer"
                class="btn btn-dark"
              >
                Open e-catalogue
              </a>
            )}
          </div>
        </div>
      </div>
      <section class="mt-12">
        <h2 class="text-2xl font-semibold text-ink-900">Specifications</h2>
        <dl class="mt-4 grid gap-4 sm:grid-cols-2">
          {Object.entries(product.specifications).map(([key, value]) => (
            <div class="rounded-2xl border border-ink-100 bg-ink-50 px-4 py-3">
              <dt class="text-xs font-semibold uppercase tracking-wide text-ink-500">{key}</dt>
              <dd class="text-sm text-ink-700">{value}</dd>
            </div>
          ))}
        </dl>
      </section>
    </div>
  </article>
</BaseLayout>
