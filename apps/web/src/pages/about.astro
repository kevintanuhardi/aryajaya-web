---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryBanner from '../components/InquiryBanner.astro';
---
<BaseLayout title="Tentang Arjaya" description="Profil perusahaan Arjaya Langgeng Medika">
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-4 py-16">
      <p class="text-sm font-semibold uppercase tracking-wide text-brand">Tentang kami</p>
      <h1 class="mt-2 text-4xl font-semibold text-slate-900">Medical supply company specializing in orthopedic products and solutions</h1>
      <div class="mt-8 grid gap-10 md:grid-cols-2">
        <div class="space-y-4 text-slate-600">
          <p>
            Arjaya Langgeng Medika is a medical supply company specializing in orthopedic products and solutions. We provide comprehensive support for musculoskeletal care, including trauma, spine, hip, knee, and other orthopedic subspecialties.
          </p>
          <p>
            Our team collaborates with trusted international manufacturers and partners with government and private hospitals across Indonesia.
          </p>
        </div>
        <div class="space-y-4 text-slate-600">
          <p>
            We are committed to delivering high-quality products, professional service, and innovative solutions to support better patient outcomes nationwide.
          </p>
          <p class="rounded-2xl bg-slate-50 p-4 text-sm text-slate-500">
            <strong class="block text-slate-800">Disclaimer:</strong>
            Informasi di website ini bersifat edukatif dan bukan pengganti konsultasi dokter. Penggunaan alat kesehatan mengikuti indikasi dan petunjuk penggunaan resmi.
          </p>
        </div>
      </div>
    </div>
  </section>
  <InquiryBanner />
</BaseLayout>
