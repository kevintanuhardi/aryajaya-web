---
import BaseLayout from '../layouts/BaseLayout.astro';
import InquiryBanner from '../components/InquiryBanner.astro';
import { aboutPage, siteSettings } from '../lib/content';
---
<BaseLayout title={aboutPage.seo.title} description={aboutPage.seo.description}>
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-4 py-16">
      <p class="eyebrow">{aboutPage.eyebrow}</p>
      <h1 class="mt-2 text-4xl font-semibold text-ink-900">{aboutPage.heading}</h1>
      {aboutPage.image && (
        <img
          src={aboutPage.image}
          alt={aboutPage.imageAlt}
          class="mt-8 max-h-[420px] w-full rounded-3xl bg-ink-50 object-cover shadow-lg"
          loading="lazy"
        />
      )}
      <div class="mt-8 grid gap-10 md:grid-cols-2">
        <div class="space-y-4 text-ink-600">
          {aboutPage.leftColumn.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <div class="space-y-4 text-ink-600">
          {aboutPage.rightColumn.map((paragraph) => <p>{paragraph}</p>)}
          {aboutPage.showDisclaimer && (
            <p class="rounded-2xl bg-ink-50 p-4 text-sm text-ink-500">
              <strong class="block text-ink-800">{aboutPage.disclaimerLabel}</strong>
              {siteSettings.disclaimer}
            </p>
          )}
        </div>
      </div>
    </div>
  </section>
  <InquiryBanner />
</BaseLayout>
