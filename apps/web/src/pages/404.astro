---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsappButton from '../components/WhatsappButton.astro';
---
<BaseLayout title="Page not found | Arjaya Langgeng Medika" description="The page you were looking for could not be found." noindex>
  <section class="bg-white">
    <div class="container-page section max-w-3xl text-center">
      <p class="eyebrow">404</p>
      <h1 class="heading-page mt-2">We couldn’t find that page</h1>
      <p class="text-body mx-auto mt-4 max-w-xl">
        The link may be out of date, or the page may have moved. Try our products or news, or ask us directly on WhatsApp.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/" class="btn btn-secondary">Home</a>
        <a href="/products" class="btn btn-secondary">Products</a>
        <a href="/events" class="btn btn-secondary">News &amp; Events</a>
        <WhatsappButton />
      </div>
    </div>
  </section>
</BaseLayout>
