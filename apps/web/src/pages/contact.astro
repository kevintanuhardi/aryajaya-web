---
import BaseLayout from '../layouts/BaseLayout.astro';
import WhatsappButton from '../components/WhatsappButton.astro';
import { siteSettings } from '../data/siteSettings';
---
<BaseLayout title="Kontak Arjaya" description="Hubungi Arjaya Langgeng Medika">
  <section class="bg-white">
    <div class="mx-auto max-w-5xl px-4 py-16">
      <h1 class="text-4xl font-semibold text-slate-900">Kontak & Lokasi</h1>
      <p class="mt-4 text-slate-600">
        Untuk demo produk dan kebutuhan pengadaan alat kesehatan, hubungi tim kami melalui WhatsApp atau kunjungi kantor kami di Jakarta Selatan.
      </p>
      <div class="mt-10 grid gap-8 md:grid-cols-2">
        <div class="space-y-4">
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Alamat</p>
            <p class="text-slate-700">{siteSettings.address}</p>
          </div>
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">WhatsApp</p>
            <p class="text-slate-700">{siteSettings.whatsapp}</p>
            <div class="mt-2">
              <WhatsappButton />
            </div>
          </div>
          {siteSettings.email && (
            <div>
              <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Email</p>
              <a class="text-brand" href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a>
            </div>
          )}
          <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-500">Maps</p>
            <a href={siteSettings.mapUrl} target="_blank" rel="noreferrer" class="text-brand">Buka di Google Maps</a>
          </div>
        </div>
        <div class="w-full overflow-hidden rounded-3xl shadow-lg">
          <iframe
            title="Lokasi Arjaya"
            src="https://www.google.com/maps?q=Graha%20Simatupang%20Tower%202C%20Jakarta&output=embed"
            width="100%"
            height="320"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
          ></iframe>
        </div>
      </div>
      <p class="mt-8 rounded-2xl bg-slate-50 p-4 text-xs text-slate-600">
        Informasi di website ini bersifat edukatif dan bukan pengganti konsultasi dokter. Penggunaan alat kesehatan mengikuti indikasi dan petunjuk penggunaan resmi.
      </p>
    </div>
  </section>
</BaseLayout>
