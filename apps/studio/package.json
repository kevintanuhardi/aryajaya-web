{
  "name": "@aryajaya/studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "deploy": "sanity deploy",
    "lint": "sanity check",
    "seed:generate": "node --experimental-strip-types --no-warnings scripts/generate-seed.mjs",
    "seed:import": "sanity dataset import seed/content.ndjson production --replace",
    "typecheck": "tsc --noEmit -p .",
    "validate:schema": "SANITY_STUDIO_PROJECT_ID=${SANITY_STUDIO_PROJECT_ID:-ci-dummy} sanity schema validate",
    "test": "npm run typecheck && npm run validate:schema"
  },
  "dependencies": {
    "@sanity/icons": "^2.11.3",
    "@sanity/vision": "^3.11.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sanity": "^3.47.1",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
