# Copy to .env.local and fill in from https://www.sanity.io/manage
# The SANITY_STUDIO_ prefix is required: Sanity only exposes these variables to the Studio in the browser.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Comma-separated Sanity user IDs that may edit pages, menu and site settings.
# Everyone else only gets Products and News & Events. Empty = no restriction.
# Find your ID with `npx sanity debug` while logged in.
SANITY_STUDIO_OWNER_IDS=
