{
  "name": "aryajaya-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@aryajaya/web",
    "dev:studio": "npm run dev --workspace=@aryajaya/studio",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:studio\"",
    "build:web": "npm run build --workspace=@aryajaya/web",
    "build:studio": "npm run build --workspace=@aryajaya/studio",
    "build": "npm run build:web && npm run build:studio",
    "deploy:studio": "npm run deploy --workspace=@aryajaya/studio"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
