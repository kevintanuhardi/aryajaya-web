{
  "$description": "Arjaya Langgeng Medika design tokens. Single source of truth for the website (Tailwind) and the admin dashboard (Sanity Studio theme). See design-system/README.md.",
  "color": {
    "brand": {
      "50": "#ECF8F5",
      "100": "#D1EFE7",
      "200": "#A3DFCF",
      "300": "#6CC8B1",
      "400": "#35A88E",
      "500": "#0D7C66",
      "600": "#0B6A57",
      "700": "#0A5747",
      "800": "#08443A",
      "900": "#052E2B"
    },
    "ink": {
      "50": "#F8FAFC",
      "100": "#F1F5F9",
      "200": "#E2E8F0",
      "300": "#CBD5E1",
      "400": "#94A3B8",
      "500": "#64748B",
      "600": "#475569",
      "700": "#334155",
      "800": "#1E293B",
      "900": "#0F172A",
      "950": "#020617"
    },
    "accent": {
      "200": "#FDE68A",
      "300": "#FCD34D",
      "500": "#F59E0B"
    },
    "semantic": {
      "success": "#0D7C66",
      "warning": "#F59E0B",
      "danger": "#DC2626",
      "info": "#0284C7"
    },
    "surface": {
      "page": "#F9FAFB",
      "card": "#FFFFFF",
      "muted": "#F8FAFC",
      "inverse": "#0F172A"
    }
  },
  "font": {
    "sans": ["Inter", "system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"],
    "mono": ["ui-monospace", "SFMono-Regular", "Menlo", "monospace"],
    "googleFontsHref": "https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
  },
  "radius": {
    "control": "9999px",
    "card": "1rem",
    "panel": "1.5rem"
  },
  "shadow": {
    "card": "0 1px 2px 0 rgb(15 23 42 / 0.05)",
    "raised": "0 10px 25px -5px rgb(15 23 42 / 0.12)",
    "brand": "0 10px 25px -8px rgb(13 124 102 / 0.35)"
  },
  "layout": {
    "containerMax": "72rem",
    "gutter": "1rem",
    "sectionY": "4rem"
  }
}
